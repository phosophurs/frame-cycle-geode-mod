{
  "geode": "5.11.2",
  "gd": {
    "win": "2.2081"
  },
  "id": "arty.frame-cycle",
  "name": "Frame Cycle",
  "version": "v0.2.0",
  "developer": "phosophurs",
  "description": "Delay jump input by Normal, 2, 4, 6, 8, or 16 game ticks. Includes mode popups and configurable keybinds.",
  "tags": [
    "gameplay",
    "utility"
  ],
  "settings": {
    "enabled": {
      "type": "bool",
      "name": "Enabled",
      "description": "Enable frame-delayed jump inputs.",
      "default": true
    },
    "cycle-key": {
      "type": "keybind",
      "name": "Cycle frame mode",
      "description": "Cycles Normal, 2, 4, 6, 8, and 16 frame input delay.",
      "default": "P",
      "category": "gameplay"
    },
    "popup-key": {
      "type": "keybind",
      "name": "Show mode popup",
      "description": "Displays the current frame mode.",
      "default": "Z",
      "category": "gameplay"
    },
    "show-popup": {
      "type": "bool",
      "name": "Show popup on mode change",
      "default": true
    }
  }
}